# Only needed for --live mode (real NEAR testnet transactions). Never commit a real .env.
# Restricted agent key (created by npm run keygen). NEVER commit or paste this.
AGENT_KEY=
OWNER_ID=omni6nt-owner.testnet
POLICY_ID=omni6nt-policy3.testnet
# The payee the demo buttons pay. Defaults to the first person on the contract's approved list.
LEGIT_ID=omni6nt-alex.testnet
# Optional: lets a real model read invoices. Without one a scripted stand-in is used.
# GEMINI_API_KEY has a free tier (Google AI Studio). Only fake invoices should be used: the text is sent to the provider.
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
