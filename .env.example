# Only needed for --live mode. Never commit a real .env.
ONE_CLICK_JWT=
REFUND_ADDRESS=            # address on the origin chain where failed swaps are refunded
ORIGIN_CHAIN=arb           # chain code as listed by OneClickService.getTokens()
ORIGIN_SYMBOL=USDC
NGN_PER_USD=1500           # indicative rate shown to the user (not a live quote)
# Optional: lets Claude parse free-form requests. Without it, a built-in parser is used.
ANTHROPIC_API_KEY=
