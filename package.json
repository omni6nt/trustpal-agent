{
  "name": "trustpal-agent",
  "version": "0.1.0",
  "description": "Trustpal: an AI-assisted business treasury on NEAR. The AI proposes payments; the owner approves the exact payment; a smart contract enforces every rule.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "keygen": "node --experimental-strip-types scripts/keygen.ts",
    "attack": "node --experimental-strip-types src/attack.ts",
    "verify-live": "node --experimental-strip-types scripts/verify-live.ts",
    "ai-models": "node --experimental-strip-types scripts/ai-models.ts",
    "redteam": "node --experimental-strip-types scripts/redteam.ts",
    "key-limits": "node --experimental-strip-types scripts/key-limits.ts",
    "web": "node --experimental-strip-types src/web.ts",
    "build:wallet": "node wallet/build.mjs",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml"
  },
  "dependencies": {
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@near-js/transactions": "^2.5.1",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "process": "^0.11.10",
    "util": "^0.12.5"
  }
}
